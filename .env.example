# Copy this file to .env and fill in your credentials
ENTSOE_API_KEY=your_api_key_here

# Daily operational pipeline and Energy Arena submission. The normal
# ``python run_pipeline`` command submits both validated payloads. Use
# ``--no-submit`` to generate them locally without posting.
ENERGY_ARENA_API_KEY=
ENERGY_ARENA_API_BASE_URL=https://api.energy-arena.org
ENERGY_ARENA_POINT_CHALLENGE_ID=2
ENERGY_ARENA_QUANTILE_CHALLENGE_ID=8
SUBMIT_TO_ENERGY_ARENA=true

# Daily model selection. Both Energy Arena challenges use the SQRA output: all
# requested quantiles go to the probabilistic challenge and q=0.5 goes to the
# point challenge. For weather-based SQRA, C=1,5,25 are always generated as
# members. POINT_WEATHER_CLUSTERS retains the reference LEAR run in metadata.
POINT_FORECAST_VARIANT=fundamental
POINT_WEATHER_CLUSTERS=5
# auto follows POINT_FORECAST_VARIANT; explicit choices are fundamental,
# exaa_enriched, and exaa_only.
SQRA_FORECAST_VARIANT=auto

# Operational ICON-D2 acquisition. Downloads are staged below this local path
# and deleted only after preprocessing and history validation succeed.
DWD_OPERATIONAL_RAW_ROOT=data/dwd_raw
# Operational market caches are independent of manuscript/backtest caches.
# Optional per-input overrides are OPERATIONAL_ENTSOE_PRICE_CACHE_DIR,
# OPERATIONAL_ENTSOE_LOAD_CACHE_DIR, and OPERATIONAL_EXAA_CACHE_DIR.
OPERATIONAL_MARKET_DATA_ROOT=data/market
# DOWNLOAD_DWD=false means the raw run already exists below the operational
# root in either supported layout;
# verification and preprocessing still run. Historical 09 UTC data may seed
# calibration while new targets use the deadline-safe 06 UTC run.
DOWNLOAD_DWD=true
# Remove only consumed run-06 variable files after C=1,5,25 histories verify.
DELETE_DWD_RAW_AFTER_PREPROCESS=true
DOWNLOAD_EXAA=auto
# Wait five minutes before retrying unavailable ENTSO-E or EXAA inputs.
MARKET_DATA_RETRY_SECONDS=300
# EXAA-Only fails after eight total EXAA attempts. Fundamental continues
# without the load feature if its fourth load-forecast attempt still fails.
EXAA_ONLY_DOWNLOAD_MAX_ATTEMPTS=8
FUNDAMENTAL_LOAD_DOWNLOAD_MAX_ATTEMPTS=4
DWD_OPEN_DATA_URL=https://opendata.dwd.de/weather/nwp/icon-d2/grib
DWD_OPERATIONAL_RUN_HOUR=06
DWD_HISTORY_FALLBACK_RUN_HOUR=09
ALLOW_DWD_HISTORY_RUN_FALLBACK=true
DWD_DOWNLOAD_MAX_ATTEMPTS=5
DWD_DOWNLOAD_RETRY_SECONDS=30
DWD_REQUEST_TIMEOUT_SECONDS=60

# One source of truth for the paper experiment (inclusive dates)
EVALUATION_START_DATE=2025-12-01
EVALUATION_END_DATE=2026-07-31

# Days excluded consistently from point forecasts, SQRA, and evaluation.
# 2026-01-22 and 2026-06-12 are incomplete in the available common inputs.
# DST transition days are retained through canonical 96-MTU normalization.
EVALUATION_SKIP_DATES=2026-01-22,2026-06-12
FORECAST_SKIP_DATES=2026-01-22,2026-06-12
DWD_FOLDER_SKIP_DATES=2025-10-26,2025-10-27,2025-10-28

# Calibration design. Point-forecast history is derived automatically as
# evaluation_start - SQRA_TRAIN_DAYS - POINT_HISTORY_BUFFER_DAYS.
SQRA_TRAIN_DAYS=60
# false: one pooled SQRA fit per quantile/day; true: one fit per MTU/quantile/day
SQRA_MTU_SPECIFIC=false
# Apply the variance-stabilizing transformation used by the submitted LEAR runs.
LEAR_USE_VST=true
MAX_LEAR_TRAIN_DAYS=364
PRICE_LAG_DAYS=7
POINT_HISTORY_BUFFER_DAYS=1

# Local/external inputs. Expected layouts are:
#   data/era5/c{1,5,25}/{2024,2025,2026}/*.csv
#   data/icon/c{1,5,25}/{u10,v10,ASWDIR_S,ASWDIFD_S}.parquet
ERA5_DATA_ROOT=data/era5
# Folder containing era5_main_YYYY.grib and era5_solar_YYYY.grib.
ERA5_RAW_ARCHIVE=/path/to/raw/ERA5
ICON_DATA_ROOT=data/icon
# Historical raw input root. Both nested or ZIP-based
# dwd_icon_daily_YYYYMMDD directories
# and dwd_icon_archived_YYYYMMDD/icon-d2__HH__VARIABLE.zip sets are supported.
DWD_RAW_ARCHIVE=/path/to/raw/ICON-D2
DWD_PREPROCESS_START_DATE=2025-08-01
# Separate cache directories can be used for each downloaded market input.
# If omitted, all three fall back to MARKET_DATA_CACHE_DIR.
MARKET_DATA_CACHE_DIR=data/cache/entsoe
ENTSOE_DE_LU_CACHE_DIR=data/cache/entsoe
EXAA_CACHE_DIR=data/cache/entsoe
ENTSOE_LOAD_FORECAST_CACHE_DIR=data/cache/entsoe
REFRESH_MARKET_DATA=false

# Preserve the submitted directory layout under a new root, leaving the
# original shorter-period results untouched.
RESULTS_ROOT=results_extended_2025-12-01_2026-07-31
OUTPUT_ROOT=output_extended_2025-12-01_2026-07-31
TARGET_TIMEZONE=Europe/Berlin

# Daily outputs are separate from manuscript/backtest outputs.
OPERATIONAL_RESULTS_ROOT=data/operational/results
OPERATIONAL_OUTPUT_ROOT=data/operational/output
